diff --git a/session/xdial_liveness_test.go b/session/xdial_liveness_test.go
--- a/session/xdial_liveness_test.go
+++ b/session/xdial_liveness_test.go
@@ -48,8 +48,49 @@
 		t.Fatalf("retry step = %#v, want one TLS DPD", retry)
 	}
 
-	if result := liveness.step(started.Add(10 * time.Second)); !result.tlsDead {
-		t.Fatalf("peer not declared dead after two DPD intervals: %#v", result)
+	// A silent TLS channel keeps probing through a satellite-style stall and
+	// is only declared dead once the minimum TLS window has passed.
+	if result := liveness.step(started.Add(10 * time.Second)); result.tlsDead {
+		t.Fatalf("TLS declared dead after a 10s stall: %#v", result)
+	}
+	cSess.xdialRecordQueued(xdialTLS)
+	cSess.XDialRecordWrite(xdialTLS, 0x03, nil)
+	if result := liveness.step(started.Add(44 * time.Second)); result.tlsDead {
+		t.Fatalf("TLS declared dead before the minimum window: %#v", result)
+	}
+	if result := liveness.step(started.Add(45 * time.Second)); !result.tlsDead {
+		t.Fatalf("TLS not declared dead after the minimum window: %#v", result)
+	}
+}
+
+func TestXDialTLSStallRecoversWhenFramesResume(t *testing.T) {
+	cSess := newXDialTestSession(t)
+	liveness := cSess.xdial
+	started := liveness.tls.lastFrame
+	resumed := started.Add(30 * time.Second)
+	if result := liveness.step(resumed); result.tlsDead {
+		t.Fatalf("TLS declared dead during a 30s stall: %#v", result)
+	}
+	liveness.now = func() time.Time { return resumed }
+	cSess.XDialRecordFrame(xdialTLS, 0x04)
+	if result := liveness.step(started.Add(70 * time.Second)); result.tlsDead {
+		t.Fatalf("resumed frame did not restart the TLS window: %#v", result)
+	}
+}
+
+func TestXDialDTLSKeepsShortDeadWindow(t *testing.T) {
+	cSess := newXDialTestSession(t)
+	liveness := cSess.xdial
+	started := liveness.tls.lastFrame
+	liveness.now = func() time.Time { return started }
+	cSess.XDialRecordTransportReady(xdialDTLS)
+	cSess.XDialRecordFrame(xdialTLS, 0x07)
+	if result := liveness.step(started.Add(9 * time.Second)); result.dtlsDead {
+		t.Fatalf("DTLS declared dead too early: %#v", result)
+	}
+	result := liveness.step(started.Add(10 * time.Second))
+	if !result.dtlsDead || result.tlsDead {
+		t.Fatalf("DTLS should fall back after two DPD intervals while TLS stays: %#v", result)
 	}
 }
 
