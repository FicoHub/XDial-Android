+// xdialTLSMinDeadWindow is how long the TLS (CSTP) channel may stay silent
+// before the session is declared dead. TCP already retransmits across short
+// outages, and satellite in-flight Wi-Fi routinely stalls for 10–30 seconds
+// during beam handovers or under deep bufferbloat while the path itself is
+// still alive. Probing keeps the fast DPD cadence; only the verdict waits.
+// Real network changes are reported by the platform and torn down there.
+// DTLS keeps the short 2×DPD window so a lossy UDP path falls back to TLS
+// quickly.
+const xdialTLSMinDeadWindow = 45 * time.Second
+
+func xdialDeadAfter(dpd, minimum time.Duration) time.Duration {
+	dead := 2 * dpd
+	if dpd > 0 && dead < minimum {
+		dead = minimum
+	}
+	return dead
+}
